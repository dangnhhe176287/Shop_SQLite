<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <EditText
        android:id="@+id/edtCustomerId"
        android:hint="Customer ID"
        android:inputType="number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/edtPaymentMethodId"
        android:hint="Payment Method ID"
        android:inputType="number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/edtOrderNote"
        android:hint="Order Note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Giả định chỉ có 1 sản phẩm để demo -->
    <EditText
        android:id="@+id/edtProductId"
        android:hint="Product ID"
        android:inputType="number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/edtVariantId"
        android:hint="Variant ID (optional)"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/edtQuantity"
        android:hint="Quantity"
        android:inputType="number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnSubmitOrder"
        android:text="Submit Order"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>

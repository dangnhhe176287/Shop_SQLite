<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/edtName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên sản phẩm"
            android:inputType="text" />

        <EditText
            android:id="@+id/edtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mô tả"
            android:inputType="textMultiLine" />

        <EditText
            android:id="@+id/edtCategoryId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ID danh mục (tùy chọn)"
            android:inputType="number" />

        <EditText
            android:id="@+id/edtBrand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Thương hiệu"
            android:inputType="text" />

        <EditText
            android:id="@+id/edtBasePrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Giá cơ bản"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Trạng thái (tùy chọn)"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/chkIsDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mark as Deleted" />

        <EditText
            android:id="@+id/edtImageUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="URL hình ảnh (tùy chọn)"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/edtAvailableSizes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Kích cỡ (comma separated, ví dụ: S,M,L)"
            android:inputType="text" />

        <EditText
            android:id="@+id/edtAvailableColors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Màu sắc (comma separated, ví dụ: Black,White)"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Biến thể"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/variantsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/variant_item" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAddVariant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thêm biến thể" />

        <Button
            android:id="@+id/btnCreate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tạo sản phẩm" />

    </LinearLayout>
</ScrollView>
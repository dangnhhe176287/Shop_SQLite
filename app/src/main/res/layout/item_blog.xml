<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="18dp"
    app:cardElevation="6dp"
    android:layout_marginBottom="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:backgroundTint="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="18dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemBlogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Blog Title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/fashion_primary"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvItemBlogSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Blog summary goes here..."
                android:textSize="15sp"
                android:textColor="@color/secondary_text"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEditBlog"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_edit"
            android:background="@android:color/transparent"
            android:contentDescription="Edit Blog"
            android:tint="@color/fashion_accent"
            android:focusable="true"
            android:clickable="true" />

        <ImageButton
            android:id="@+id/btnDeleteBlog"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_delete"
            android:background="@android:color/transparent"
            android:contentDescription="Delete Blog"
            android:tint="@color/fashion_primary"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

</androidx.cardview.widget.CardView> 
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/header_card_background"
        android:padding="24dp"
        android:layout_margin="16dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/txtHeader"
            android:text="Product Categories"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="@color/colorPrimary"
            android:gravity="center"
            android:letterSpacing="0.02"/>

        <View
            android:layout_width="60dp"
            android:layout_height="4dp"
            android:background="@drawable/accent_line"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quản lý danh mục sản phẩm"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:alpha="0.8"/>

    </LinearLayout>

    <!-- Add Button Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnAddCategory"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="+ Add New Category"
            android:backgroundTint="?attr/colorAccent"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/add_button_background"
            android:elevation="2dp"
            android:letterSpacing="0.02"
            android:drawableLeft="@drawable/ic_add"
            android:drawablePadding="8dp"
            android:gravity="center"/>

    </LinearLayout>

    <!-- Categories List Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/list_container_background"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="2dp">

        <!-- List Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/list_header_background"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Danh sách danh mục"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"/>


        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E6ED"/>

        <!-- ListView Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp">

            <ListView
                android:id="@+id/listViewCategories"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/listview_background"
                android:divider="@drawable/list_divider"
                android:dividerHeight="1dp"
                android:padding="8dp"
                android:clipToPadding="false"
                android:scrollbars="vertical"
                android:fadeScrollbars="true"
                android:overScrollMode="ifContentScrolls"/>

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyStateLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:padding="32dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_empty_category"
                    android:alpha="0.3"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chưa có danh mục nào"
                    android:textSize="16sp"
                    android:textColor="#999999"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhấn nút 'Add New Category' để thêm danh mục đầu tiên"
                    android:textSize="14sp"
                    android:textColor="#CCCCCC"
                    android:gravity="center"
                    android:alpha="0.8"/>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- Bottom Shadow -->
    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@drawable/bottom_shadow"/>

</LinearLayout>